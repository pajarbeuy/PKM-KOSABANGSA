APP_NAME="SumberTani AI"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://sumbertani.example.com
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

# ── Security & Access Control ──────────────────────────────
# Masukkan domain frontend / mobile app web yang diizinkan (pisahkan koma)
CORS_ALLOWED_ORIGINS="https://sumbertani.example.com"
CORS_SUPPORTS_CREDENTIALS=true
# Masa berlaku token Sanctum (dalam menit, 10080 = 7 hari)
SANCTUM_EXPIRATION=10080

BCRYPT_ROUNDS=12

# ── Logging (Daily Rotation untuk cegah disk penuh di VPS) ─
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ── Database (Production Docker MySQL) ─────────────────────
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=sumbertani
DB_USERNAME=sumbertani_user
DB_PASSWORD=GANTI_DENGAN_PASSWORD_DATABASE_KUAT
DB_ROOT_PASSWORD=GANTI_DENGAN_PASSWORD_ROOT_KUAT

# ── Session & Cache ────────────────────────────────────────
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=sumbertani_cache

# ── Redis ──────────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=cache
REDIS_PASSWORD=GANTI_DENGAN_PASSWORD_REDIS_KUAT
REDIS_PORT=6379

# ── Mail Server (SMTP Riil untuk Notifikasi / Reset Sandi) ──
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=postmaster@sumbertani.example.com
MAIL_PASSWORD=GANTI_DENGAN_PASSWORD_SMTP
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@sumbertani.example.com"
MAIL_FROM_NAME="SumberTani AI"

# ── Frontend Web / App URL ─────────────────────────────────
FRONTEND_URL=https://sumbertani.example.com

# ── AI Chatbot Service (OpenRouter) ────────────────────────
OPENROUTER_API_KEY=GANTI_DENGAN_OPENROUTER_API_KEY_BARU
OPENROUTER_MODEL=qwen/qwen3.8-27b:free
OPENROUTER_FALLBACK_MODELS="qwen/qwen3.8-27b:free,openrouter/free,google/gemma-4-31b-it:free,nvidia/nemotron-3-super-120b-a12b:free"
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT=30
OPENROUTER_SITE_NAME="SumberTani AI"
